{{!
    @template local_kopere_pay/index_webpages

    Example context (json):
    {
        "menus": [
            {
                "menulink": true,
                "title": "Menu Principal",
                "link": "mainmenu",
                "webpages": [
                    {
                        "link": "https://example.com/course-detail",
                        "background": "https://example.com/images/course-thumbnail.jpg",
                        "title": "Curso de Desenvolvimento Web",
                        "text": "Aprenda a desenvolver aplicações web modernas com tecnologias avançadas.",
                        "course-price": "R$ 199,90",
                        "offprice": "R$ 299,90",
                        "access": "Acessar Curso"
                    }
                ]
            }
        ]
    }
}}

<div class="container">
    {{#menus}}
        {{#menulink}}
            <h3><a href="{{{config.wwwroot}}}/local/kopere_dashboard/?menu={{{link}}}">{{{title}}}</a></h3>
        {{/menulink}}
        <div class="row">
            {{#webpages}}
                <div class="col-lg-4 col-md-6 col-sm-12 mb-3">
                    <div class="box-page">
                        <div class="thumbnail">
                            <a href="{{{link}}}">
                                <span style="background-image:url({{{background}}})"></span>
                            </a>
                        </div>
                        <div class="content">
                            <h5 class="title"><a href="{{{link}}}">{{{title}}}</a></h5>
                            {{#text}}
                                <p>{{{text}}}</p>
                            {{/text}}

                            <div class="price">
                                <span class="current-price">{{{course-price}}}</span>
                                {{#offprice}}
                                    <span class="off-price">{{{offprice}}}</span>
                                {{/offprice}}
                            </div>
                            <a href="{{{link}}}" class="btn btn-primary">{{{access}}}</a>
                        </div>
                    </div>
                </div>
            {{/webpages}}
        </div>
    {{/menus}}
</div>