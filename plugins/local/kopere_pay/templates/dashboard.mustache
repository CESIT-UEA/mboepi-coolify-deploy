{{!
    @template local_kopere_pay/dashboard

    Example context (json):
    {
      "tables": [
        {
          "title": "Pagamentos recentes",
          "tableid": "kopere_pay_recent_payments",
          "hasmessage": true,
          "messagehtml": "<p>Lista dos pagamentos mais recentes registrados no sistema.</p>",
          "headers": [
            {
              "key": "user",
              "title": "Usuário",
              "hasstyle": true,
              "style": "width: 30%;"
            },
            {
              "key": "course",
              "title": "Curso",
              "hasstyle": true,
              "style": "width: 30%;"
            }
          ]
        },
        {
          "title": "Assinaturas ativas",
          "tableid": "kopere_pay_active_subscriptions",
          "hasmessage": false,
          "messagehtml": "",
          "headers": [
            {
              "key": "user",
              "title": "Usuário",
              "hasstyle": false,
              "style": ""
            },
            {
              "key": "plan",
              "title": "Plano",
              "hasstyle": false,
              "style": ""
            }
          ]
        }
      ],
      "cohortdisabled": true,
      "cohortdisabledtitle": "Coortes desativadas",
      "cohortdisabledmessage": "<p>O recurso de coortes está desativado neste ambiente. Algumas funcionalidades de agrupamento podem não estar disponíveis.</p>"
    }
}}

{{#tables}}
    <div class="kopere_dashboard-card">
        <h3>{{title}}</h3>

        {{#hasmessage}}
            {{{messagehtml}}}
        {{/hasmessage}}

        <table id="{{{tableid}}}" class="table table-hover">
            <thead>
            <tr>
                {{#headers}}
                    <th class="text-center th_{{key}}"{{#hasstyle}} style="{{{style}}}"{{/hasstyle}}>
                        {{title}}
                    </th>
                {{/headers}}
            </tr>
            </thead>
            <tbody class="hover-pointer"></tbody>
        </table>
    </div>
{{/tables}}

{{#cohortdisabled}}
    <div class="kopere_dashboard-card">
        <h3>{{cohortdisabledtitle}}</h3>
        {{{cohortdisabledmessage}}}
    </div>
{{/cohortdisabled}}
