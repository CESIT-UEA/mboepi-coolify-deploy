{{!
    @template local_kopere_pay/util/payment_button

    Example context (json):
    {
      "action": "https://payments.example.com/checkout",
      "inputs": "<input type=\"hidden\" name=\"orderid\" value=\"98765\">\n<input type=\"hidden\" name=\"amount\" value=\"49.00\">\n<input type=\"hidden\" name=\"currency\" value=\"USD\">\n<input type=\"hidden\" name=\"returnurl\" value=\"https://your-moodle-site.example/local/kopere_pay/return.php\">",
      "methodclass": "creditcard",
      "buttontext": "Pay with Credit Card",
      "extra": "<small class=\"text-muted\">You will be redirected to the payment provider to complete your purchase.</small>"
    }
}}

<form class="botao-meio" target="_blank" action="{{{action}}}" method="post">
    {{{inputs}}}
    <div>
        <button id="button_{{methodclass}}" style="width:100%"
                class="btn btn-success bt-submit botao"
                type="submit">{{buttontext}}</button>
    </div>
    {{{extra}}}
</form>
