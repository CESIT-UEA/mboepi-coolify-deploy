{{!
    @template local_kopere_pay/util/order_summary

    Example context (json):
    {
      "coursefullname": "Introduction to Data Analysis",
      "value": "$49.00",
      "total": "$49.00"
    }
}}

<div class="kopere_dashboard-card well2 order-area">
    <h3 class="text-center">{{#str}}order_summary_title, local_kopere_pay{{/str}}:</h3>

    <table class="table table-bordered" style="margin:0 auto;width:100%;">
        <tr>
            <th class="text-center">{{#str}}summary_table_course, local_kopere_pay{{/str}}</th>
            <th class="text-center">{{#str}}summary_table_quantity, local_kopere_pay{{/str}}</th>
            <th class="text-center">{{#str}}summary_table_value, local_kopere_pay{{/str}}</th>
        </tr>
        <tr>
            <td>{{coursefullname}}</td>
            <td class="text-center">1</td>
            <td class="text-center">{{value}}</td>
        </tr>
        <tr>
            <th colspan="2" class="text-right">{{#str}}summary_table_total_label, local_kopere_pay{{/str}}:</th>
            <td class="text-center">{{total}}</td>
        </tr>
    </table>
</div>
