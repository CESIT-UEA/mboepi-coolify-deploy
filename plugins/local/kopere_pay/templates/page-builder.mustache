{{!
    @template local_kopere_pay/page-builder

    Example context (json):
    {
      "topo": "<h2>Course Enrollment</h2><p>Welcome! Below you can find the course overview, curriculum, and how to enroll.</p>",
      "titulo": "Full Stack Development Bootcamp",
      "admin": {
        "has_capability": true,
        "edit": "https://example.com/admin/pagebuilder/edit?id=42"
      },
      "paginas": [
        {
          "page_id": 1,
          "titulo": "Overview",
          "titulolongo": "Course Overview",
          "conteudo": "<p>This bootcamp will take you from fundamentals to building production-ready applications.</p><ul><li>Duration: 8 weeks</li><li>Format: Online</li><li>Support: Weekly live Q&A</li></ul>"
        },
        {
          "page_id": 2,
          "titulo": "Curriculum",
          "titulolongo": "Curriculum & Modules",
          "conteudo": "<p>Modules include:</p><ol><li>HTML, CSS, and JavaScript</li><li>APIs and Backend Basics</li><li>Databases</li><li>Deployment</li></ol>"
        }
      ],
      "youtube": {
        "id": "dQw4w9WgXcQ",
        "tags": [
          "id='youtube-video'",
          "class ='youtube-video'"
        ]
      },
      "imagem_curso": "",
      "is_enrolled": false,
      "curso_link": "https://example.com/course/view.php?id=123",
      "showprice": true,
      "current-price": "249,90",
      "off-price": "349,90",
      "comprar": {
        "link": "https://example.com/local/kopere_pay/checkout.php?courseid=123",
        "tags": [
          "id='comprar-iframe'",
          "class ='comprar-iframe'"
        ]
      },
      "coursedetails": "<ul class=\"enrollment-course-details-list\"><li><span>Access:</span> 12 months</li><li><span>Level:</span> Beginner to Intermediate</li><li><span>Certificate:</span> Included</li><li><span>Language:</span> English</li></ul>",
      "whatsapp-link": "https://wa.me/5511999999999?text=Hi%21%20I%20have%20a%20question%20about%20the%20course.",
      "whatsapp-numero": "+55 (11) 99999-9999"
    }
}}

<div class="enrollment-course-details-area">
    <div class="container">
        <div class="row g-5">

            <div class="col-lg-8">

                <div class="enrollment-page-top">
                    <div class="content text-start">
                        {{{topo}}}

                        {{#admin.has_capability}}
                            <p><a href="{{{admin.edit}}}"
                                  class="btn btn-primary">{{#str}}pagebuilder_edit_page, local_kopere_pay{{/str}}</a>
                            </p>
                        {{/admin.has_capability}}
                    </div>
                </div>

                <div class="enrollment-paginas enrollment-sticky-top mt--30">
                    <nav class="mainmenu-nav onepagenav">
                        <ul class="mainmenu">
                            {{#paginas}}
                                {{#titulo}}
                                    {{#conteudo}}
                                        <li data-action="page-{{page_id}}" id="for-page-{{page_id}}">
                                            <a href="#page-{{page_id}}">{{{titulo}}}</a>
                                        </li>
                                    {{/conteudo}}
                                {{/titulo}}
                            {{/paginas}}
                        </ul>
                    </nav>
                </div>

                {{#paginas}}
                    {{#titulo}}
                        {{#conteudo}}
                            <div class="course-details-content">
                                <div class="enrollment-shadow mt--30 active"
                                     id="page-{{page_id}}">
                                    <div class="section-title">
                                        <h4 class="enrollment-title">{{{titulolongo}}}</h4>
                                    </div>
                                    <div>
                                        {{{conteudo}}}
                                    </div>
                                </div>
                            </div>
                        {{/conteudo}}
                    {{/titulo}}
                {{/paginas}}

            </div>

            <div class="col-lg-4">
                <div class="course-sidebar enrollment-sticky-top">
                    <div class="inner">

                        {{#youtube}}
                            <div id="video-popup-wrapper" class="text-center mb-3">
                                <div class="video-content">
                                    <img src="https://i3.ytimg.com/vi/{{id}}/maxresdefault.jpg" alt="img">
                                    <div class="position-to-top"
                                         data-toggle="modal" data-target="#youtube-modal">
                                        <span class="enrollment-btn rounded-player-2 with-animation">
                                            <span class="play-icon"></span>
                                        </span>
                                    </div>
                                </div>
                            </div>
                        {{/youtube}}
                        {{#imagem_curso}}
                            <div id="image-popup-wrapper" class="text-center mb-3">
                                <div class="video-content">
                                    <img src="{{{imagem_curso}}}" alt="img">
                                </div>
                            </div>
                        {{/imagem_curso}}

                        <div class="content-item-content">

                            {{#is_enrolled}}
                                <div class="add-to-card-button mt--15">
                                    <a class="enrollment-btn btn-gradient icon-hover w-100 d-block text-center"
                                       href="{{{curso_link}}}">
                                        <span class="btn-text">{{#str}}
                                            pagebuilder_go_to_course, local_kopere_pay{{/str}}</span>
                                    </a>
                                </div>
                            {{/is_enrolled}}
                            {{^is_enrolled}}
                                {{#showprice}}
                                    <div class="enrollment-price-wrapper d-flex flex-wrap align-items-center justify-content-between">
                                        <div class="enrollment-price">
                                            <span class="current-price">R${{current-price}}</span>
                                            {{#off-price}}
                                                <span class="off-price">{{off-price}}</span>
                                            {{/off-price}}
                                        </div>
                                    </div>
                                {{/showprice}}
                                <div class="add-to-card-button mt--15">
                                    <a class="enrollment-btn btn-gradient icon-hover w-100 d-block text-center"
                                       id="enrollment-comprar-btn"
                                       data-toggle="modal"
                                       data-target="#comprar-modal"
                                       data-src="{{{comprar.link}}}&iframe=1&r="
                                       href="{{{comprar.link}}}">
                                        <span class="btn-text">{{#str}}
                                            pagebuilder_enroll_now, local_kopere_pay{{/str}}</span>
                                    </a>
                                </div>
                                <div class="enrollment-widget-details active">
                                    <div class="enrollment-course-details-list-wrapper">
                                        {{{coursedetails}}}
                                    </div>
                                </div>

                                {{#whatsapp-link}}
                                    <div class="social-share-wrapper mt--30 text-center">
                                        <div class="contact-with-us text-center">
                                            <p>{{#str}}pagebuilder_course_details, local_kopere_pay{{/str}}</p>
                                            <div class="enrollment-badge-2 mt-2 w-100">
                                                {{#pix}}whatsapp, local_kopere_pay{{/pix}}
                                                <a class="text-nowrap"
                                                   href="{{whatsapp-link}}"
                                                   target="_blank">{{{whatsapp-numero}}}</a>
                                            </div>
                                        </div>
                                    </div>
                                {{/whatsapp-link}}
                            {{/is_enrolled}}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

{{#youtube}}
    <div class="modal fade" id="youtube-modal" tabindex="-1" role="dialog"
         aria-labelledby="youtube-modal-label" aria-hidden="true">
        <div class="modal-dialog" role="document"
             style="max-width: 900px;">
            <div class="modal-content">
                <div class="modal-header" style="padding: 8px;">
                    <h5 class="modal-title" id="youtube-modal-label">{{{titulo}}}</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close"
                            id="youtube-close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body"
                     style="padding:8px;position:relative;overflow:hidden;width:100%;padding-top: 56.25%;">
                    <iframe {{#youtube.tags}} {{{.}}} {{/youtube.tags}}
                            data-src="https://www.youtube-nocookie.com/embed/{{youtube.id}}?rel=0&controls=1&autoplay=0&playsinline=1&start=0&enablejsapi=1&widgetid=1"></iframe>
                </div>
            </div>
        </div>
    </div>
{{/youtube}}

{{^is_enrolled}}
    <div class="modal fade" id="comprar-modal" tabindex="-1" role="dialog"
         aria-labelledby="comprar-modal-label" aria-hidden="true">
        <div class="modal-dialog" role="document"
             style="max-width: 900px;">
            <div class="modal-content">
                <div class="modal-header" style="padding: 8px;">
                    <h5 class="modal-title" id="comprar-modal-label">{{{titulo}}}</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body" style="padding: 8px;">
                    <iframe {{#comprar.tags}} {{{.}}} {{/comprar.tags}}
                            data-src="{{{comprar.link}}}&iframe=1&r="></iframe>
                </div>
            </div>
        </div>
    </div>
{{/is_enrolled}}
