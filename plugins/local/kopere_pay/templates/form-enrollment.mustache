{{!
    @template local_kopere_pay/formulario-enrollment

    Example context (json):
    {
      "offprice": "$199.00",
      "value_original": "$149.00",
      "coupon": null,
      "show_form_coupon": true,
      "couponlength": 10,
      "coupon_error": "",
      "type_charge": "Total to pay",
      "value_pagar": "$149.00"
    }

}}

<div class="kopere_dashboard-card well2 order-area">
    <h3 class="text-center">{{#str}}order_summary_title, local_kopere_pay{{/str}}</h3>
    {{#offprice}}
        <div class="clearfix">
            <div class="order-left  text-left ">{{#str}}order_original_price, local_kopere_pay{{/str}}:</div>
            <div class="order-right text-right">{{{offprice}}}</div>
        </div>
    {{/offprice}}
    <div class="clearfix">
        <div class="order-left  text-left ">{{#str}}order_course_value, local_kopere_pay{{/str}}:</div>
        <div class="order-right text-right">{{{value_original}}}</div>
    </div>
    {{#coupon}}
        <div class="clearfix">
            <div class="order-left  text-left ">{{text_desconto}}</div>
            <div class="order-right text-right">{{{value_desconto}}}</div>
        </div>
    {{/coupon}}
    {{#show_form_coupon}}
        <div class="clearfix">
            <div class="order-left">
                {{#str}}order_has_coupon, local_kopere_pay{{/str}}
                <input type="text" id="coupon" maxlength="{{{couponlength}}}"
                       style="width:120px" class="text-uppercase">
            </div>
        </div>
    {{/show_form_coupon}}
    {{{coupon_error}}}
    <hr>
    <div class="clearfix">
        <div class="order-left  text-left "><strong>{{{type_charge}}}</strong></div>
        <div class="order-right text-right"><strong>{{{value_pagar}}}</strong></div>
    </div>
</div>
