{{!
    @template local_kopere_pay/html/input-checkbox

    Example context (json):
    {
      "check-id": "accept_terms",
      "extra": "I agree to the <a href=\"#\" target=\"_blank\" rel=\"noopener\">Terms &amp; Conditions</a>."
    }
}}

<div id="area_{{{check-id}}}"
     class="form-group area_{{{check-id}}} d-flex flex-center"
     style="align-items: center;">

    <div class="kopere-checkbox">
        <input id="{{{check-id}}}"
               name="{{{check-id}}}"
               type="checkbox"
               value="1"
               required>
        <label for="{{{check-id}}}"></label>
    </div>

    {{#extra}}
        <div class="help-block form-text mt-0" style="font-size: 1.2em !important;">
            {{{extra}}}
        </div>
    {{/extra}}
</div>

