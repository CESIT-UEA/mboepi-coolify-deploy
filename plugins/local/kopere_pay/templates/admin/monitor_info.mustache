{{!
    @template local_kopere_pay/admin/monitor_info

    Example context (json):
    {
      "cards": [
        {
          "bg": "#e8f5e9",
          "label": "Total Orders",
          "value": "128",
          "url": "https://moodle.example/local/kopere_pay/admin/orders.php"
        },
        {
          "bg": "#e3f2fd",
          "label": "Pending Payments",
          "value": "7",
          "url": "https://moodle.example/local/kopere_pay/admin/orders.php?status=pending"
        }
      ]
    }
}}

<div class="row">
    {{#cards}}
        <div class="col-sm-4">
            <div class="kopere_dashboard-card" style="background:{{bg}}">
                <div class="label">{{label}}</div>
                <div class="value">
                    <a href="{{{url}}}">{{value}}</a>
                </div>
            </div>
        </div>
    {{/cards}}
</div>
