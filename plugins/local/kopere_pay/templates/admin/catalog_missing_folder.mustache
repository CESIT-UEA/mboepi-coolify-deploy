{{!
    @template local_kopere_pay/admin/catalog_missing_folder

    Example context (json):
    {
      "intro": "We couldn’t find the required catalog folder for this course. You can create it automatically by clicking the link below.",
      "canautocreate": true,
      "autocreateurl": "https://moodle.example/local/kopere_pay/catalog/create_folder.php?courseid=123",
      "instructionsurl": "https://moodle.example/local/kopere_pay/catalog/manual-folder-setup"
    }
}}

<p>{{intro}}</p>

{{#canautocreate}}
    <p>
        <a href="{{{autocreateurl}}}">
            {{#str}}catalog_create_folder_auto, local_kopere_pay{{/str}}
        </a>
    </p>
{{/canautocreate}}

{{^canautocreate}}
    <p>
        {{#str}}catalog_create_folder_permission_error, local_kopere_pay{{/str}}
        <a href="{{{instructionsurl}}}">
            {{#str}}catalog_create_folder_manual_link, local_kopere_pay{{/str}}
        </a>.
    </p>
{{/canautocreate}}
