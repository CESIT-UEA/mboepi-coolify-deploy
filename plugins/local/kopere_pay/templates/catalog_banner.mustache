{{!
    @template local_kopere_pay/index_webpages

    Example context (json):
    {
        "haslink": true,
        "link": "https://example.com/course-detail",
        "image": "https://example.com/images/course-thumbnail.jpg",
        "color": "#ff00ff"
    }
}}

<div class="local-kopere-pay-catalog-banner">
    <div class="local-kopere-pay-catalog-banner-image"
         style="--banner-color: {{color}}; background-image: url('{{{image}}}');"
         role="img"
         aria-label="{{{alt}}}">
        <div class="local-kopere-pay-catalog-banner-content">
            {{{title}}}
        </div>
    </div>
</div>
<style>
    #page-header,
    .page-header-headings {
        display: none !important;
    }

    /* Nice Theme */
    .kopere-dashboard-pages-nice .page-title-area,
    .kopere-dashboard-pages-nice .nice-page-context-header-container {
        display: none !important;
    }
    .kopere-dashboard-pages-nice #page {
        padding-top: 0;
    }
    .kopere-dashboard-pages-nice.kopere-dashboard-pages .local-kopere-pay-catalog-banner{
        border-radius: 12px;
        margin-bottom: 30px;
    }
</style>