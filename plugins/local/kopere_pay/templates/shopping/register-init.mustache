{{!
    @template local_kopere_pay/shopping/register-init

    Example context (json):
    {
      "show_extra": false,
      "extra": "",
      "course": 123,
      "resume": "<div class=\"kopere_dashboard-card well2 order-area\"><h3 class=\"text-center\">Order Summary</h3><div class=\"clearfix\"><div class=\"order-left text-left\">Course price:</div><div class=\"order-right text-right\">$149.00</div></div><hr><div class=\"clearfix\"><div class=\"order-left text-left\"><strong>Total to pay</strong></div><div class=\"order-right text-right\"><strong>$149.00</strong></div></div></div>",
      "extra-config": ""
    }
}}

{{#show_extra}}
    <div class="well">
        <div class="well2">
            {{{extra}}}
        </div>
    </div>
{{/show_extra}}

<div class="well">
    <div class="row form-enrollment">
        <div class="col-lg-7 col-12">
            <div class="kopere_dashboard-card text-center">
                <form method="post">
                    <input type="hidden" name="id" value="{{{course}}}">
                    <input type="hidden" name="testeemail" value="1">
                    <input type="hidden" name="coupon" id="copy-coupon">
                    <script>
                        document.addEventListener('DOMContentLoaded', function () {
                            const couponInput = document.getElementById('coupon');
                            const copyCupomInput = document.getElementById('copy-coupon');

                            couponInput.addEventListener('input', function () {
                                copyCupomInput.value = couponInput.value;
                            });
                        });
                    </script>
                    <div>
                        <input type="email" id="your-email" name="your-email"
                               placeholder="{{#str}}order_your_email, local_kopere_pay{{/str}}">
                    </div>
                    <div>
                        <input class="botao" type="submit"
                               value="{{#str}}order_next, local_kopere_pay{{/str}}">
                    </div>
                </form>
            </div>
        </div>
        <div class="col-lg-5 col-12">{{{resume}}}</div>
    </div>
</div>
{{{extra-config}}}
