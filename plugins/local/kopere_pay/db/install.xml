<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="local/kopere_pay/db" VERSION="2026020700" COMMENT=""
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:noNamespaceSchemaLocation="../../../lib/xmldb/xmldb.xsd">
    <TABLES>

        <TABLE NAME="local_kopere_pay_coupon" COMMENT="Coupons for a course/cohort purchase flow.">
            <FIELDS>
                <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
                <FIELD NAME="course" TYPE="char" LENGTH="11" NOTNULL="false" SEQUENCE="false"/>
                <FIELD NAME="type" TYPE="char" LENGTH="11" NOTNULL="false" SEQUENCE="false"/>
                <FIELD NAME="uniquekey" TYPE="char" LENGTH="20" NOTNULL="false" SEQUENCE="false"/>
                <FIELD NAME="email" TYPE="char" LENGTH="150" NOTNULL="false" SEQUENCE="false"/>
                <FIELD NAME="amount" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false"/>
                <FIELD NAME="value" TYPE="char" LENGTH="11" NOTNULL="false" SEQUENCE="false"/>
                <FIELD NAME="time" TYPE="int" LENGTH="20" NOTNULL="false" SEQUENCE="false"/>
            </FIELDS>
            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
            </KEYS>
            <INDEXES>
                <INDEX NAME="course" UNIQUE="false" FIELDS="course"/>
                <INDEX NAME="uniquekey" UNIQUE="false" FIELDS="uniquekey"/>
                <INDEX NAME="email" UNIQUE="false" FIELDS="email"/>
                <INDEX NAME="type-course" UNIQUE="false" FIELDS="type, course"/>
            </INDEXES>
        </TABLE>

        <TABLE NAME="local_kopere_pay_detail" COMMENT="Course/cohort product configuration.">
            <FIELDS>
                <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
                <FIELD NAME="course" TYPE="char" LENGTH="32" NOTNULL="false" SEQUENCE="false"/>
                <FIELD NAME="price" TYPE="char" LENGTH="20" NOTNULL="false" SEQUENCE="false"/>
                <FIELD NAME="days" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false"/>
                <FIELD NAME="date" TYPE="char" LENGTH="10" NOTNULL="false" SEQUENCE="false"/>
                <FIELD NAME="students" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false"/>
                <FIELD NAME="charge" TYPE="char" LENGTH="11" NOTNULL="false" SEQUENCE="false"/>
                <FIELD NAME="status" TYPE="char" LENGTH="8" NOTNULL="false" SEQUENCE="false"/>
                <FIELD NAME="link" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
                <FIELD NAME="extra" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
                <FIELD NAME="extradata" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
                <FIELD NAME="fieldcategory" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false"/>
                <FIELD NAME="portfolio" TYPE="char" LENGTH="10" NOTNULL="true" DEFAULT="invisivel" SEQUENCE="false"/>
            </FIELDS>
            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
            </KEYS>
            <INDEXES>
                <INDEX NAME="course" UNIQUE="false" FIELDS="course"/>
                <INDEX NAME="portfolio" UNIQUE="false" FIELDS="portfolio"/>
                <INDEX NAME="status" UNIQUE="false" FIELDS="status"/>
            </INDEXES>
        </TABLE>

        <TABLE NAME="local_kopere_pay_history" COMMENT="Gateway request/response history per enrollment purchase.">
            <FIELDS>
                <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
                <FIELD NAME="enrollmentid" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false"/>
                <FIELD NAME="send" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
                <FIELD NAME="receive" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
                <FIELD NAME="error" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
                <FIELD NAME="time" TYPE="int" LENGTH="20" NOTNULL="false" SEQUENCE="false"/>
            </FIELDS>
            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
            </KEYS>
            <INDEXES>
                <INDEX NAME="enrollmentid" UNIQUE="false" FIELDS="enrollmentid"/>
                <INDEX NAME="time" UNIQUE="false" FIELDS="time"/>
                <INDEX NAME="enrollmentid-time" UNIQUE="false" FIELDS="enrollmentid, time"/>
            </INDEXES>
        </TABLE>

        <TABLE NAME="local_kopere_pay_enrollment" COMMENT="Purchase/enrollment status per user and course/cohort.">
            <FIELDS>
                <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
                <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false"/>
                <FIELD NAME="course" TYPE="char" LENGTH="20" NOTNULL="false" SEQUENCE="false"/>
                <FIELD NAME="coupon" TYPE="char" LENGTH="20" NOTNULL="false" SEQUENCE="false"/>
                <FIELD NAME="value" TYPE="char" LENGTH="20" NOTNULL="false" SEQUENCE="false"/>
                <FIELD NAME="method" TYPE="char" LENGTH="30" NOTNULL="false" SEQUENCE="false"/>
                <FIELD NAME="status" TYPE="char" LENGTH="15" NOTNULL="false" SEQUENCE="false"/>
                <FIELD NAME="lasttime" TYPE="int" LENGTH="20" NOTNULL="false" SEQUENCE="false"/>
            </FIELDS>
            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
            </KEYS>
            <INDEXES>
                <INDEX NAME="userid" UNIQUE="false" FIELDS="userid"/>
                <INDEX NAME="course" UNIQUE="false" FIELDS="course"/>
                <INDEX NAME="userid-course" UNIQUE="false" FIELDS="userid, course"/>
                <INDEX NAME="status-lasttime" UNIQUE="false" FIELDS="status, lasttime"/>
                <INDEX NAME="coupon" UNIQUE="false" FIELDS="coupon"/>
            </INDEXES>
        </TABLE>

    </TABLES>
</XMLDB>
